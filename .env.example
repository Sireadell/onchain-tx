# Server
PORT=3000

# Ankr — required. Free key at ankr.com/rpc/advanced-api.
# Used against the per-chain standard JSON-RPC endpoint
# (rpc.ankr.com/{chain}/{key}), NOT the /multichain/ Advanced API endpoint —
# see BUILD_SPEC.md Transport section for why the two aren't interchangeable.
ANKR_API_KEY=

# Default chain used when a request omits the `chain` query param
# (backward compatible with the original single-chain deployment). This
# instance actually serves all five allowlisted chains — eth, base,
# arbitrum, optimism, polygon — from one process via one Ankr API key; see
# src/lib/chains.js for the allowlist. Defaults to 'eth' if unset.
CHAIN=eth

# Confirmation depth (in blocks) below which a confirmed tx is reported at
# reduced confidence as reorg-sensitive rather than final. See BUILD_SPEC.md
# Confidence Semantics.
CONFIRMATION_DEPTH=12

# Optional timeout override (milliseconds)
ANKR_CALL_TIMEOUT_MS=8000

# Twelve Data is the primary STOCK_PRICE provider. Create a key at
# twelvedata.com. If unset, the endpoint falls back to Yahoo Finance.
TWELVE_DATA_API_KEY=
TWELVE_DATA_CALL_TIMEOUT_MS=5000

# Optional. Second-choice WEATHER_FORECAST/STORM_ALERT provider, tried when
# Open-Meteo fails, before MET Norway. Free key at openweathermap.org/api,
# no card required. If unset, that tier is skipped and MET Norway (no real
# precipitation-probability data outside the Nordics) is used directly.
OPENWEATHERMAP_API_KEY=
